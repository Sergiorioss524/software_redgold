# Copy to .env and adjust once you've confirmed the live page markup.

# Database. Leave unset for local dev (falls back to a SQLite file at
# REDGOLD_DB_PATH). In production (Vercel), DATABASE_URL / POSTGRES_URL is
# injected automatically by the Postgres storage integration -- no need to
# set it yourself there.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# REDGOLD_DB_PATH=data/redgold.db

# REDGOLD_BCB_URL=https://www.bcb.gob.bo/?q=content/tabla-de-cotizaciones
# REDGOLD_BCB_SELECTOR=table

# REDGOLD_NETDANIA_URL=https://m.netdania.com/commodities
# REDGOLD_NETDANIA_SELECTOR=table

# REDGOLD_HTTP_TIMEOUT=15

# REDGOLD_MIN_PRICE=500
# REDGOLD_MAX_PRICE=20000

# --- Ledger defaults (see redgold/ledger.py) ---
# REDGOLD_DEFAULT_PURITY_PCT=0.95
# REDGOLD_ROYALTY_EXPORT=0.009
# REDGOLD_ROYALTY_BCB=0.048
# REDGOLD_DEFAULT_COMMISSION_PCT=0.0
# REDGOLD_OPERATING_COST_PCT=0.07125

# Flask session secret for the web dashboard (redgold/webapp.py).
# REDGOLD_SECRET_KEY=change-me
